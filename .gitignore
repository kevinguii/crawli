# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.pytest_cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
# Globbed, not exact: a bare `/crawl4ai-service/venv` misses sibling copies like
# venv.bak-stale-path, which is how a 761MB backup venv (with a 113MB patchright
# node binary, over GitHub's 100MB file limit) once got staged and blocked a push.
/python/venv*
/crawl4ai-service/venv*
/crawl4ai-service/.env.example
/crawl4ai-service/__pycache__
/crawl4ai-service/.crawl4ai
/crawl4ai-service/debug_dumps
*.pyc
__pycache__/
*.egg-info/
.python-version
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# personal
.claude
.mcp.json
.gsc/
# Sentry Config File
.env.sentry-build-plugin

# Marketing exports. Extensions are listed exhaustively on purpose: `*.jpg` alone
# missed `rick-hook.jpeg`, which stayed trackable long after the rule landed.
docs/marketing/**/*.png
docs/marketing/**/*.jpg
docs/marketing/**/*.jpeg
docs/marketing/**/*.webp
docs/marketing/**/*.gif
docs/marketing/**/*.mp4
docs/marketing/**/*.mov
docs/marketing/*.zip

# Runtime logs
token_usage.jsonl

.playwright-mcp
.superpowers/
