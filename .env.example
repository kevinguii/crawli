FIRECRAWL_API_KEY=""

# Optional Serper.dev API key. Only used when SEARCH_PROVIDER=serper (and by
# scripts/search_bakeoff.py). Free tier: 2,500 queries/mo, no card.
SERPER_API_KEY=""

# Which provider to use for URL discovery. Default = firecrawl (legacy
# behavior). Set to "serper" to swap in the Serper.dev adapter — the call
# shape and returned RawSearchResult[] are identical, so the rest of the
# pipeline is unchanged.
# SEARCH_PROVIDER=firecrawl

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─────────────────────────────────────────────────────────────
# LLM provider for crawl4ai extraction.
# Leave LLM_PROVIDER empty to run in STUB MODE (no LLM call —
# the page is fetched but only the page title is returned).
# ─────────────────────────────────────────────────────────────

# Pick one when you have a key:
LLM_PROVIDER=openai/gpt-4o-mini
# LLM_PROVIDER=anthropic/claude-sonnet-4-5
# LLM_PROVIDER=gemini/gemini-2.0-flash         # cheap but rate-limits aggressively
# LLM_PROVIDER=ollama/llama3.1                 # local, no key required
# LLM_PROVIDER=groq/llama-3.3-70b-versatile    # free tier (no card needed)

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

PORT=8000

# ─────────────────────────────────────────────────────────────
# Concurrency / load-protection knobs
# (PR 1 — sidecar concurrency hardening, see HANDOFF Latest change)
# ─────────────────────────────────────────────────────────────

# Sidecar (Python): max simultaneous crawler.arun() calls across ALL pool
# members. Defends the box against the all-platforms fan-out from the Next
# route. Going past machine capacity makes the Playwright driver
# subprocess die under load → all subsequent scrapes fail with
# "BrowserContext.new_page: ... the handler is closed".
#
# Recommended per host (see SCALING.md for the full tier matrix):
#   Local dev / 8 GB MacBook    SIDECAR_MAX_CONCURRENT_RENDERS=6   POOL_SIZE=1
#   Small VPS (2 GB, $10-20/mo) SIDECAR_MAX_CONCURRENT_RENDERS=4   POOL_SIZE=1
#   Medium VPS (4-8 GB)         SIDECAR_MAX_CONCURRENT_RENDERS=8   POOL_SIZE=2
#   Large box / dedicated       SIDECAR_MAX_CONCURRENT_RENDERS=12  POOL_SIZE=3
SIDECAR_MAX_CONCURRENT_RENDERS=6

# B1: how many independent Chromium browser instances to run in parallel.
# Default 1 = pre-B1 behavior (single browser). Bump to 2+ on a server with
# enough CPU/RAM to power multiple browsers — each pool member is its own
# Chromium subprocess but they share SIDECAR_MAX_CONCURRENT_RENDERS, so total
# load is still bounded. Pool>1 helps when:
#   - The box has spare CPU/RAM after one Chromium is busy.
#   - A single driver death should only take down 1/N of capacity (rest of
#     the pool keeps serving while restart finishes).
# Pool=1 on a laptop is correct — adding browsers there just thrashes RAM.
# See SCALING.md for which tier needs what.
SIDECAR_BROWSER_POOL_SIZE=1

# Next.js (route): cap on simultaneous platforms entering the scrape phase.
# Each platform is allowed 2 concurrent scrapes internally, so the
# effective sidecar load is roughly SEARCH_PLATFORM_CONCURRENCY * 2.
# Keep this <= SIDECAR_MAX_CONCURRENT_RENDERS / 2.
#
# Firecrawl plan: free=2, paid=5 concurrent search calls. This is
# informational only — raising SEARCH_PLATFORM_CONCURRENCY above your plan
# tier doesn't error; Firecrawl just queues the overflow on its end,
# adding latency to URL discovery (not scraping — scraping is self-hosted
# crawl4ai and has no Firecrawl ceiling).
SEARCH_PLATFORM_CONCURRENCY=3

# ─────────────────────────────────────────────────────────────
# Watchlist refresh load-management knobs
# (PR — watchlist parity with /scrape; see SCALING.md tier matrix)
# ─────────────────────────────────────────────────────────────

# Sidecar: cap on simultaneous Tier-1 httpx GETs from /refresh-price. Tier
# 2/3 share the render semaphore above; Tier 1 is cheap but uncapped would
# let a 1000-item watchlist refresh open 1000 sockets. Default 12.
# SIDECAR_MAX_CONCURRENT_HTTP=12

# Next.js (/api/watchlist/refresh): max in-flight per-row refresh workers.
# Mirrors SEARCH_PLATFORM_CONCURRENCY shape. Default 4.
#   Local dev / 8 GB MacBook     WATCHLIST_REFRESH_CONCURRENCY=4
#   Small VPS (2 GB, $10-20/mo)  WATCHLIST_REFRESH_CONCURRENCY=2
#   Medium VPS (4-8 GB)          WATCHLIST_REFRESH_CONCURRENCY=4
#   Large box / dedicated        WATCHLIST_REFRESH_CONCURRENCY=6
# WATCHLIST_REFRESH_CONCURRENCY=4

# Set REALREAL_ENABLED=1 to attempt The RealReal scraping. Deferred by
# default (PerimeterX press-and-hold defeats UndetectedAdapter today).
# REALREAL_ENABLED=1

# Set TOKEN_TRACKING=1 to write OpenAI token usage to token_usage.jsonl.
# TOKEN_TRACKING=1
