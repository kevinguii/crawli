{
  "name": "crawler",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 109",
    "edge >= 109",
    "firefox >= 102",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:sidecar": "cd crawl4ai-service && venv/bin/python -m uvicorn main:app --port 8000",
    "dev:all": "concurrently -n next,sidecar -c blue,green \"npm:dev\" \"npm:dev:sidecar\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@mendable/firecrawl-js": "^4.23.0",
    "@sentry/nextjs": "^10.53.1",
    "@stripe/stripe-js": "^9.6.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "date-fns": "^4.2.1",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.4",
    "nanoid": "^5.0.0",
    "next": "16.2.6",
    "puppeteer": "^25.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
