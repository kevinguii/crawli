            {
                "parameters": {
                    "jsCode": "const record = $('Webhook').first().json.body.record;\nconst aiText = $('Message a model').first().json.output[0].content[0].text;\nconst tryOnImage = $('Generate Try-On Image').first().json;\nconst imageUrl = tryOnImage.imageUrl || record.image_url || 'https://thecrawli.com/opengraph-image';\n\nreturn [{\n  json: {\n    content: aiText,\n    publishNow: true,\n    mediaItems: [{ \n      type: 'image', \n      url: imageUrl\n    }],\n    platforms: [{\n      platform: 'pinterest',\n      accountId: '6a454bd69d9472faae43601f',\n      platformSpecificData: {\n        boardId: '1089308297311595703',\n        link: 'https://thecrawli.com',\n        title: (record.title || '').substring(0, 100)\n      }\n    }]\n  }\n}];"
                },
